# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (optional — used when model starts with "claude-")
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (optional — used when model starts with "deepseek-")
DEEPSEEK_API_KEY=sk-...

# Server
PORT=4000

# Comma-separated allowed origins for CORS
# Dev default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
