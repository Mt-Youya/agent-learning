    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.6.0",
    "ai": "^6.0.208",
    "axios": "^1.18.0",
    "dotenv": "^17.4.2",
    "koa": "^3.2.1",
    "koa-body": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "tsup": "^8.5.1",
