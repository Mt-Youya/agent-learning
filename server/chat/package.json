{
  "name": "@agent-learning/chat",
  "version": "1.0.0",
  "description": "Koa + OpenAI streaming chat service for AgentLab frontend",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
